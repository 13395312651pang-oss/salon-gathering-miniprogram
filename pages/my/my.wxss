/* pages/my/my.wxss */
.page {
  min-height: 100vh;
  background: #f5f5f7;
}

.user-card {
  background: linear-gradient(135deg, #1a1a2e, #6c5ce7);
  padding: 60rpx 40rpx 50rpx;
  color: #fff;
}

.user-info {
  display: flex;
  align-items: center;
}

.avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(255, 255, 255, 0.3);
}

.avatar.placeholder {
  background: rgba(255, 255, 255, 0.2);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 50rpx;
}

.user-text {
  margin-left: 28rpx;
}

.nickname {
  font-size: 36rpx;
  font-weight: 600;
}

.desc {
  font-size: 24rpx;
  opacity: 0.8;
  margin-top: 8rpx;
}

.menu-card {
  margin: -30rpx 24rpx 24rpx;
  position: relative;
  z-index: 2;
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 32rpx 28rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-icon {
  font-size: 36rpx;
  margin-right: 20rpx;
}

.menu-text {
  flex: 1;
  font-size: 28rpx;
  color: #333;
}

.menu-arrow {
  color: #ccc;
  font-size: 28rpx;
}

.section {
  padding: 0 24rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 20rpx;
  color: #1a1a2e;
}

.reg-item {
  padding: 28rpx;
  margin-bottom: 16rpx;
}

.reg-title {
  font-size: 28rpx;
  font-weight: 500;
  margin-bottom: 10rpx;
}

.reg-meta {
  font-size: 24rpx;
  color: #666;
}

.reg-time {
  font-size: 22rpx;
  color: #999;
  margin-top: 8rpx;
}