<!--pages/create/create.wxml-->
<view class="page">
  <view class="form-card card">
    <view class="form-item">
      <view class="label required">活动标题</view>
      <input class="input" placeholder="请输入活动标题" data-field="title" bindinput="onInput" value="{{form.title}}" />
    </view>

    <view class="form-item">
      <view class="label required">活动日期</view>
      <picker mode="date" value="{{form.date}}" bindchange="onDateChange">
        <view class="picker {{form.date ? '' : 'placeholder'}}">{{form.date || '请选择日期'}}</view>
      </picker>
    </view>

    <view class="form-item">
      <view class="label required">活动时间</view>
      <input class="input" placeholder="例如 19:00-21:00" data-field="time" bindinput="onInput" value="{{form.time}}" />
    </view>

    <view class="form-item">
      <view class="label required">活动地点</view>
      <input class="input" placeholder="例如 北京市朝阳区xxx" data-field="location" bindinput="onInput" value="{{form.location}}" />
    </view>

    <view class="form-item">
      <view class="label">详细地址</view>
      <input class="input" placeholder="选填" data-field="address" bindinput="onInput" value="{{form.address}}" />
    </view>

    <view class="form-row">
      <view class="form-item half">
        <view class="label">费用（元）</view>
        <input class="input" type="digit" placeholder="0为免费" data-field="price" bindinput="onInput" value="{{form.price}}" />
      </view>
      <view class="form-item half">
        <view class="label">人数上限</view>
        <input class="input" type="number" placeholder="默认50" data-field="maxPeople" bindinput="onInput" value="{{form.maxPeople}}" />
      </view>
    </view>

    <view class="form-item">
      <view class="label">分类</view>
      <picker range="{{categories}}" bindchange="onCategoryChange">
        <view class="picker">{{form.category}}</view>
      </picker>
    </view>

    <view class="form-item">
      <view class="label">主办方</view>
      <input class="input" placeholder="选填" data-field="host" bindinput="onInput" value="{{form.host}}" />
    </view>

    <view class="form-item">
      <view class="label">标签</view>
      <input class="input" placeholder="用逗号分隔，如 AI,分享" data-field="tags" bindinput="onInput" value="{{form.tags}}" />
    </view>

    <view class="form-item">
      <view class="label">活动介绍</view>
      <textarea class="textarea" placeholder="介绍一下你的沙龙吧" data-field="description" bindinput="onInput" value="{{form.description}}" maxlength="500" />
    </view>
  </view>

  <button class="btn-primary submit-btn" bindtap="onSubmit">发布活动</button>
</view>