/* pages/create/create.wxss */
.page {
  padding: 24rpx;
  padding-bottom: 60rpx;
}

.form-card {
  padding: 32rpx;
  margin-bottom: 32rpx;
}

.form-item {
  margin-bottom: 28rpx;
}

.form-row {
  display: flex;
  gap: 20rpx;
}

.form-item.half {
  flex: 1;
}

.label {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 12rpx;
}

.label.required::before {
  content: '*';
  color: #e17055;
  margin-right: 6rpx;
}

.input, .picker {
  background: #f5f5f7;
  border-radius: 12rpx;
  height: 80rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  line-height: 80rpx;
}

.picker.placeholder {
  color: #999;
}

.textarea {
  background: #f5f5f7;
  border-radius: 12rpx;
  width: 100%;
  height: 200rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.submit-btn {
  width: 100%;
  margin: 0;
}