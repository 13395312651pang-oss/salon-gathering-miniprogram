/* pages/checkin/checkin.wxss */
.page {
  padding: 40rpx 32rpx;
  text-align: center;
}

.header {
  margin-bottom: 60rpx;
}

.title {
  font-size: 40rpx;
  font-weight: 600;
  color: #1a1a2e;
}

.subtitle {
  font-size: 26rpx;
  color: #999;
  margin-top: 12rpx;
}

.actions {
  margin-bottom: 40rpx;
}

.scan-btn {
  width: 100%;
  margin-bottom: 24rpx;
}

.manual-btn {
  width: 100%;
  height: 80rpx;
  line-height: 80rpx;
}

.result {
  padding: 40rpx;
  margin-bottom: 40rpx;
}

.result-icon {
  font-size: 64rpx;
  margin-bottom: 16rpx;
}

.result-msg {
  font-size: 30rpx;
  font-weight: 500;
}

.result-code {
  font-size: 22rpx;
  color: #999;
  margin-top: 12rpx;
  word-break: break-all;
}

.tips {
  text-align: left;
  font-size: 24rpx;
  color: #999;
  line-height: 1.8;
  padding: 0 20rpx;
}