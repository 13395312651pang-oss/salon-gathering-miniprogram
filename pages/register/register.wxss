/* pages/register/register.wxss */
.page {
  padding: 24rpx;
  padding-bottom: 60rpx;
}

.event-summary {
  padding: 28rpx;
  margin-bottom: 24rpx;
}

.event-title {
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 12rpx;
}

.event-meta {
  font-size: 24rpx;
  color: #999;
  margin-top: 6rpx;
}

.form-card {
  padding: 32rpx;
  margin-bottom: 24rpx;
}

.form-title {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 28rpx;
}

.form-item {
  margin-bottom: 28rpx;
}

.label {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 12rpx;
}

.label.required::before {
  content: '*';
  color: #e17055;
  margin-right: 6rpx;
}

.input {
  background: #f5f5f7;
  border-radius: 12rpx;
  height: 80rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
}

.textarea {
  background: #f5f5f7;
  border-radius: 12rpx;
  width: 100%;
  height: 160rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.tips {
  font-size: 24rpx;
  color: #999;
  text-align: center;
  margin-bottom: 40rpx;
  padding: 0 20rpx;
}

.submit-btn {
  width: 100%;
  margin: 0;
}