/**app.wxss**/
page {
  background-color: #f5f5f7;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', sans-serif;
  color: #1a1a2e;
  font-size: 28rpx;
  line-height: 1.5;
}

.container {
  padding: 24rpx 32rpx;
  box-sizing: border-box;
}

/* 通用卡片 */
.card {
  background: #ffffff;
  border-radius: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.06);
  overflow: hidden;
  margin-bottom: 24rpx;
}

/* 按钮 */
.btn-primary {
  background: linear-gradient(135deg, #6c5ce7, #a29bfe);
  color: #fff;
  border-radius: 48rpx;
  font-size: 30rpx;
  font-weight: 500;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  border: none;
}

.btn-primary::after {
  border: none;
}

.btn-outline {
  background: transparent;
  color: #6c5ce7;
  border: 2rpx solid #6c5ce7;
  border-radius: 48rpx;
  font-size: 28rpx;
  height: 72rpx;
  line-height: 72rpx;
  text-align: center;
}

/* 标签 */
.tag {
  display: inline-block;
  padding: 6rpx 16rpx;
  background: rgba(108, 92, 231, 0.1);
  color: #6c5ce7;
  border-radius: 8rpx;
  font-size: 22rpx;
  margin-right: 12rpx;
}

/* 状态标签 */
.status-ongoing {
  background: rgba(0, 184, 148, 0.15);
  color: #00b894;
}

.status-upcoming {
  background: rgba(108, 92, 231, 0.15);
  color: #6c5ce7;
}

.status-ended {
  background: rgba(99, 110, 114, 0.15);
  color: #636e72;
}

/* 空状态 */
.empty {
  text-align: center;
  padding: 120rpx 0;
  color: #999;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}